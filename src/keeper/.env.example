# Helius RPC
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=YOUR_KEY

# Vault config
VAULT_PUBKEY=YOUR_VAULT_ADDRESS
MANAGER_PUBKEY=YOUR_MANAGER_ADDRESS

# Keeper settings
KEEPER_INTERVAL_MS=1800000
DRIFT_THRESHOLD_PCT=2.0
APY_CHANGE_THRESHOLD_PCT=1.0
MAX_SLIPPAGE_BPS=50

# ML model (optional, falls back to greedy allocation)
ML_MODEL_URL=http://localhost:8000/predict

# Strategy definitions (JSON array)
KEEPER_STRATEGIES='[{"id":"klend-usdc","pubkey":"...","protocol":"kamino","enabled":true,"maxAllocationPct":40,"minAllocationPct":5},{"id":"marginfi-usdc","pubkey":"...","protocol":"marginfi","enabled":true,"maxAllocationPct":40,"minAllocationPct":5}]'

# Marginfi account (required if using marginfi strategies)
MARGINFI_ACCOUNT=YOUR_MARGINFI_ACCOUNT

# Cobo MPC
COBO_API_SECRET=YOUR_COBO_API_SECRET
COBO_ENV=dev
COBO_VAULT_ID=YOUR_VAULT_ID
COBO_WALLET_ID=YOUR_WALLET_ID
COBO_ORG_ID=YOUR_ORG_ID
COBO_CALLBACK_URL=

# Circuit breaker
CB_MAX_TX_PER_MIN=5
CB_MAX_TX_PER_HOUR=30
CB_MAX_SINGLE_TX_USD=10000
CB_MAX_DAILY_VOLUME_USD=100000

# Monitoring
VAULT_ADDRESS=YOUR_VAULT_ADDRESS
HELIUS_WEBHOOK_SECRET=
ALERT_WEBHOOK_URL=
